# Copy this file to .env and fill these in from Supabase: Project Settings → API.
# These are public client values. Never put a Supabase service_role key in this app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_TMDB_API_KEY=your-tmdb-api-key
